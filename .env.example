# Copy this file to .env.local and fill in your values.
# Without a key the arena still works in OFFLINE mode (scripted personalities).

# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: which Claude model the agents use (default: claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5
